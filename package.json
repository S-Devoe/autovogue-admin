{
  "name": "autovogue-admin",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3300",
    "build": "vite build && node scripts/csp.mjs production && tsc --noEmit",
    "build:staging": "vite build --mode staging && node scripts/csp.mjs staging && tsc --noEmit",
    "build:production": "vite build --mode production && node scripts/csp.mjs production && tsc --noEmit",
    "preview": "vite preview --port 3300",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:local": "vite build --mode development && node scripts/csp.mjs local",
    "test:e2e": "playwright test",
    "test:e2e:dev": "E2E_BASE_URL=http://localhost:3300 playwright test",
    "size": "node scripts/bundle-size.mjs 400"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@sentry/react": "10.22.0",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "1.169.4",
    "axios": "^1.21.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.70.0",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "3.10.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^31.0.0",
    "msw": "2.11.3",
    "tailwindcss": "^4.3.4",
    "typescript": "5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@11.0.8"
}
