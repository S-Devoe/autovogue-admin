# Copy to e2e/.env (gitignored). A local staff account with 2FA already set
# up, e.g. created with `make platform-staff/create` in the API repo and
# enrolled once in the app. Use test accounts on your local database only.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
# The base32 secret shown under "Can't scan?" when 2FA was set up.
E2E_ADMIN_TOTP_SECRET=
# Optional: one account per default role for e2e/roles.spec.ts (each
# skipped when unset). Create with `make platform-staff/create` and enrol 2FA.
E2E_SUPPORT_EMAIL=
E2E_SUPPORT_PASSWORD=
E2E_SUPPORT_TOTP_SECRET=
E2E_OPERATIONS_EMAIL=
E2E_OPERATIONS_PASSWORD=
E2E_OPERATIONS_TOTP_SECRET=
E2E_FINANCE_EMAIL=
E2E_FINANCE_PASSWORD=
E2E_FINANCE_TOTP_SECRET=
E2E_AUDITOR_EMAIL=
E2E_AUDITOR_PASSWORD=
E2E_AUDITOR_TOTP_SECRET=
# Optional overrides
# E2E_BASE_URL=http://localhost:3300
# E2E_API_URL=http://localhost:4000/api/v1
# PW_CHANNEL=chrome
